{
    "name": "@ubio/framework-monorepo",
    "version": "18.0.0-rc.0",
    "description": "UBIO Framework",
    "author": "UBIO",
    "license": "ISC",
    "private": true,
    "type": "module",
    "homepage": "https://github.com/ubio/framework#readme",
    "bugs": {
        "url": "https://github.com/ubio/framework/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/ubio/framework.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "pre-commit": [
        "lint"
    ],
    "scripts": {
        "clean": "run-s clean:workspaces clean:ts",
        "clean:workspaces": "npm run clean --workspaces --if-present",
        "clean:ts": "rm -rf packages/*/{out,*.tsbuildinfo}",
        "dev": "npm run clean && run-p dev:*",
        "dev:ts": "tsc -b -w",
        "compile:ts": "tsc -b",
        "lint": "eslint . --fix",
        "test": "npm run test --workspaces --if-present",
        "version": "run-s clean compile:ts version:bump",
        "version:bump": "bump-version && git add **/package.json",
        "postversion": "npm run publish:workspaces && git push && git push --tags",
        "publish:workspaces": "npm publish $(ls-publish-workspaces) --access=public --tag=next"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@fastify/pre-commit": "^2.2.1",
        "@flexent/eslint-config": "^2.1.0",
        "@flexent/repo-tools": "^2.1.0",
        "@types/node": "^24.9.0",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3"
    }
}
