{
    "name": "@ubio/framework",
    "version": "18.4.1",
    "description": "UBIO Application Framework",
    "author": "UBIO",
    "license": "ISC",
    "type": "module",
    "main": "./out/main/index.js",
    "types": "./out/main/index.d.ts",
    "exports": {
        ".": {
            "types": "./out/main/index.d.ts",
            "default": "./out/main/index.js"
        },
        "./backend": {
            "types": "./out/main/backend.d.ts",
            "default": "./out/main/backend.js"
        },
        "./vue": {
            "types": "./out/main/vue.d.ts",
            "default": "./out/main/vue.js"
        }
    },
    "files": [
        "out"
    ],
    "homepage": "https://github.com/ubio/framework#readme",
    "bugs": {
        "url": "https://github.com/ubio/framework/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/ubio/framework.git"
    },
    "pre-commit": [
        "lint"
    ],
    "scripts": {
        "clean": "run-s clean:ts",
        "clean:ts": "rm -rf out *.tsbuildinfo",
        "dev": "npm run clean && run-p dev:*",
        "dev:ts": "tsc -b -w",
        "compile": "run-s compile:*",
        "compile:ts": "tsc -b",
        "lint": "eslint . --fix",
        "test": "NODE_ENV=test mocha",
        "version": "run-s clean compile",
        "postversion": "npm publish --access=public --tag=next && git push && git push --tags"
    },
    "dependencies": {
        "@flexent/errors": "^2.16.1",
        "@flexent/http-router": "^2.16.1",
        "@flexent/http-server": "^2.16.1",
        "@flexent/http-proxy": "^2.16.1",
        "@flexent/init-decorator": "^2.16.1",
        "@flexent/jwt": "^2.16.1",
        "@flexent/logger": "^2.16.1",
        "@flexent/metrics": "^2.16.1",
        "@flexent/pathmatcher": "^2.16.1",
        "@flexent/pointer": "^2.16.1",
        "@flexent/protocomm": "^2.16.1",
        "@flexent/protocomm-http": "^2.16.1",
        "@flexent/protocomm-ws": "^2.16.1",
        "@flexent/stack-backend": "^2.16.1",
        "@flexent/stack-vue": "^2.16.1",
        "@flexent/ws-proxy": "^2.16.1"
    },
    "peerDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "jsonwebtoken": "^9.0.3",
        "mesh-config": "^1.3.4",
        "mesh-ioc": "^4.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@fastify/pre-commit": "^2.2.1",
        "@flexent/eslint-config": "^2.16.1",
        "@flexent/repo-tools": "^2.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.9.0",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "mocha": "^12.0.0-beta-9.6",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3"
    }
}
