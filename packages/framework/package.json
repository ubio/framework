{
    "name": "@ubio/framework",
    "version": "18.0.0-rc.3",
    "description": "Thin wrapper around @flexent/* modules",
    "license": "ISC",
    "type": "module",
    "main": "./out/main/index.js",
    "types": "./out/main/index.d.ts",
    "exports": {
        ".": {
            "types": "./out/main/index.d.ts",
            "default": "./out/main/index.js"
        },
        "./backend": {
            "types": "./out/main/backend.d.ts",
            "default": "./out/main/backend.js"
        },
        "./vue": {
            "types": "./out/main/vue.d.ts",
            "default": "./out/main/vue.js"
        }
    },
    "files": [
        "out"
    ],
    "dependencies": {
        "@flexent/errors": "^2.1.0",
        "@flexent/http-router": "^2.1.0",
        "@flexent/http-server": "^2.1.0",
        "@flexent/init-decorator": "^2.1.0",
        "@flexent/logger": "^2.1.0",
        "@flexent/metrics": "^2.1.0",
        "@flexent/pathmatcher": "^2.1.0",
        "@flexent/pointer": "^2.1.0",
        "@flexent/protocomm": "^2.1.0",
        "@flexent/stack-backend": "^2.1.0",
        "@flexent/stack-vue": "^2.1.0"
    }
}
